# Public address of the site. Used for canonical URLs, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://chefni.com

# Store listings. Leave empty while the app is in development: the badges show
# "Coming soon". Fill them in and the badges turn into download links.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
